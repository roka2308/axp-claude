{
  "name": "@axp/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background worker process. Same codebase and domain logic as the API.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@axp/config": "*",
    "@axp/contracts": "*",
    "@axp/core": "*",
    "@axp/db": "*",
    "@axp/observability": "*"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
