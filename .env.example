# ---------------------------------------------------------------------------
# Analytics Experience Platform - local development configuration
#
# Copy to .env and adjust. .env is git-ignored and must never contain
# production secrets. Generate the two key values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
# central_multi_tenant | dedicated_single_customer | customer_hosted
DEPLOYMENT_PROFILE=central_multi_tenant
LOG_LEVEL=debug
# pretty | json  (json is required in production)
LOG_FORMAT=pretty

# --- Processes ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000

# --- Product store (MySQL) ---------------------------------------------------
# Matches docker-compose.yml. Host port 3307 avoids clashing with a local MySQL.
DATABASE_URL=mysql://axp:axp_dev@127.0.0.1:3307/axp
DATABASE_POOL_LIMIT=10
MYSQL_ROOT_PASSWORD=axp_root_dev
MYSQL_DATABASE=axp
MYSQL_USER=axp
MYSQL_PASSWORD=axp_dev
MYSQL_PORT=3307
ADMINER_PORT=8081

# Integration tests run against a separate database (created by docker/mysql/init).
TEST_DATABASE_URL=mysql://axp:axp_dev@127.0.0.1:3307/axp_test

# --- Secrets -----------------------------------------------------------------
# Signs session cookies. 32+ bytes, base64.
SESSION_SECRET=CHANGE_ME_base64_32_bytes
# Encrypts Matomo credentials at rest (AES-256-GCM). 32 bytes, base64.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# --- Sessions ----------------------------------------------------------------
SESSION_COOKIE_NAME=axp_session
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_LIFETIME_HOURS=12
# Window in which a recent authentication counts for sensitive actions.
REAUTH_WINDOW_MINUTES=15

# --- Bootstrap ---------------------------------------------------------------
# Lifetime of the one-time platform bootstrap activation token.
BOOTSTRAP_TOKEN_TTL_MINUTES=60

# --- Analytics runtime -------------------------------------------------------
# Ephemeral in-memory cache only. A persistent analytics cache is On Hold and
# must not be enabled without a separate security/privacy decision.
ANALYTICS_CACHE_TTL_SECONDS=60
ANALYTICS_CACHE_MAX_ENTRIES=500
ANALYTICS_QUERY_TIMEOUT_MS=15000
ANALYTICS_MAX_PARALLEL_QUERIES=6

# --- Matomo ------------------------------------------------------------------
# mock | http
MATOMO_ADAPTER=mock

# --- Exports -----------------------------------------------------------------
# Finished export files are encrypted, readable only by their requester and
# deleted after this many minutes. Default directory: .local/exports
# EXPORT_ARTIFACT_DIR=
EXPORT_ARTIFACT_TTL_MINUTES=15

# --- Mail --------------------------------------------------------------------
# console | smtp
MAIL_TRANSPORT=console
MAIL_FROM="Analytics Experience <no-reply@example.invalid>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Demo / fixtures ---------------------------------------------------------
# Refused when APP_ENV=production. Loads the canonical Pulse demo fixture.
ENABLE_DEMO_FIXTURES=true
